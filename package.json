{
  "name": "carrier",
  "version": "1.15.0",
  "description": "A tiny, distraction-free desktop client for Facebook Messenger, built with Tauri.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:share-extension": "bun share-extension/macos/build.ts",
    "tauri": "tauri",
    "icon": "tauri icon",
    "build:inject": "bun inject/build.ts",
    "lint": "biome check inject scripts/debug",
    "format": "biome check --write inject scripts/debug",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.tools.json",
    "check": "bun run lint && bun run typecheck && bun test && bun run build:inject",
    "build:debug": "tauri build --debug --features diagnostics",
    "debug:update": "bun scripts/debug/update.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tauri-apps/cli": "^2.11.5",
    "@types/bun": "^1.4.2",
    "esbuild": "^0.28.2",
    "tauri-plugin-mcp-server": "0.3.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "fast-uri": "3.1.8",
    "hono": "4.13.8",
    "ip-address": "10.7.2"
  }
}
