{
  "name": "carrier",
  "version": "1.10.2",
  "description": "A tiny, distraction-free desktop client for Facebook Messenger, built with Tauri.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:share-extension": "bun share-extension/macos/build.ts",
    "tauri": "tauri",
    "icon": "tauri icon",
    "build:inject": "bun inject/build.ts",
    "lint": "biome check inject",
    "format": "biome check --write inject",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "check": "bun run lint && bun run typecheck && bun test && bun run build:inject"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.0",
    "esbuild": "^0.28.2",
    "tauri-plugin-mcp-server": "0.3.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "fast-uri": "3.1.5",
    "hono": "4.13.2",
    "ip-address": "10.5.0"
  }
}
