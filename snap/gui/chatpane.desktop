[Desktop Entry]
Type=Application
Name=Chatpane
Comment=Unofficial desktop app for Facebook Messenger
Exec=chatpane
Icon=${SNAP}/usr/share/icons/hicolor/512x512/apps/chatpane.png
Categories=Network;Chat;InstantMessaging;
Keywords=Messenger;Facebook;Chat;Message;Chatpane;
StartupWMClass=chatpane
Terminal=false
Actions=new-conversation;settings;

[Desktop Action new-conversation]
Name=New Conversation
Exec=chatpane --new-conversation

[Desktop Action settings]
Name=Settings
Exec=chatpane --settings
