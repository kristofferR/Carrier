[Desktop Entry]
Type=Application
Name=Chatpane
Comment=Distraction-free Messenger desktop client
Exec=chatpane
Icon=${SNAP}/usr/share/icons/hicolor/512x512/apps/carrier.png
Categories=Network;Chat;InstantMessaging;
Keywords=Messenger;Facebook;Chat;Message;Carrier;
StartupWMClass=carrier
Terminal=false
Actions=new-conversation;settings;

[Desktop Action new-conversation]
Name=New Conversation
Exec=chatpane --new-conversation

[Desktop Action settings]
Name=Settings
Exec=chatpane --settings
