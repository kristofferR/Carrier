<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the generated app bundle's Info.plist by Tauri at build time. -->
<plist version="1.0">
<dict>
  <key>NSCameraUsageDescription</key>
  <string>Chatpane needs camera access for Messenger video calls.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Chatpane needs microphone access for Messenger voice and video calls.</string>
  <!-- Saving Messenger media lands in ~/Downloads, which macOS protects via TCC
       (Files and Folders) even for non-sandboxed apps. This purpose string is the
       message shown in the permission prompt macOS raises on the first save. -->
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Chatpane saves photos, videos, and files you download from Messenger to your Downloads folder.</string>
  <!-- Chatpane's text is localized in src-tauri/locales (zh-Hans is zh-CN).
       Listing the languages lets macOS's own UI, such as file panels and
       the context menus WebKit adds, follow the user's language too. -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>ar</string>
    <string>bn</string>
    <string>cs</string>
    <string>da</string>
    <string>de</string>
    <string>el</string>
    <string>es</string>
    <string>fil</string>
    <string>fr</string>
    <string>hi</string>
    <string>hu</string>
    <string>id</string>
    <string>it</string>
    <string>km</string>
    <string>lo</string>
    <string>my</string>
    <string>nb</string>
    <string>ne</string>
    <string>pl</string>
    <string>pt-BR</string>
    <string>ro</string>
    <string>si</string>
    <string>sv</string>
    <string>th</string>
    <string>tr</string>
    <string>uk</string>
    <string>ur</string>
    <string>vi</string>
    <string>zh-Hans</string>
  </array>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
  </dict>
  <!-- Communication notifications donate message intents (Ref #366). -->
  <key>NSUserActivityTypes</key>
  <array>
    <string>INSendMessageIntent</string>
  </array>
  <!-- LaunchServices delivers chatpane:// automation URLs and share-extension
       handoffs to the running instance, or launches Chatpane when needed. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>app.chatpane.Chatpane</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>chatpane</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
