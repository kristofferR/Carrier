{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The trusted local settings window. It calls Chatpane's own commands (get/set settings, themes, sounds, check for and explicitly install updates or open package-manager instructions, its window controls) and reads the app version. The notification plugin's startup script asks whether notifications are permitted in every window, so allow that query here too.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "notification:allow-is-permission-granted",
    "allow-window-control",
    "allow-get-settings",
    "allow-autostart-status",
    "allow-open-login-items",
    "allow-update-setting",
    "allow-reset-settings",
    "allow-check-for-updates",
    "allow-update-install-mode",
    "allow-open-manual-update",
    "allow-discovered-update",
    "allow-update-release-notes",
    "allow-install-update",
    "allow-open-log-folder",
    "allow-restart-app",
    "allow-open-custom-css",
    "allow-send-test-notification",
    "allow-copy-share-message",
    "allow-open-github",
    "allow-messenger-account",
    "allow-set-messenger-account",
    "allow-messenger-profile",
    "allow-log-out",
    "allow-open-facebook-language",
    "allow-list-themes",
    "allow-add-theme",
    "allow-remove-theme",
    "allow-open-themes-folder",
    "allow-open-theme-guide",
    "allow-list-fonts",
    "allow-notification-sounds",
    "allow-choose-notification-sound",
    "allow-preview-notification-sound",
    "allow-copy-messenger-sound"
  ]
}
