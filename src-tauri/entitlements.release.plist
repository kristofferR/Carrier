<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- WKWebView's JavaScript engine needs JIT under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Allow loading the bundled WebView/runtime libraries. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Hardened Runtime blocks camera/mic outright (no TCC prompt) without
       these, so Messenger calls can't get devices in signed builds. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Release builds only (Ref #366): communication notifications show the
       sender's face. A restricted entitlement, so macOS launches the app only
       with the matching Developer ID provisioning profile, embedded by CI as
       Contents/embedded.provisionprofile, and the identifiers it names. -->
  <key>com.apple.developer.usernotifications.communication</key>
  <true/>
  <key>com.apple.application-identifier</key>
  <string>S5Q742QZEL.app.chatpane.Chatpane</string>
  <key>com.apple.developer.team-identifier</key>
  <string>S5Q742QZEL</string>
</dict>
</plist>
